#!/bin/bash

set -euo pipefail

all_ws_id_name() {
  niri msg --json workspaces | \
  jq --raw-output '.[] | (.id |tostring) + " " + .output + " - " + (.idx | tostring) + ":" + .name'
}

all_win_ws_id_title() {
  niri msg --json windows |
    jq -r '.[] | ((.workspace_id | tostring) + " ( " + (.id | tostring) + " " + .app_id + " ) " + .title)'
}

declare -A workspaces

while read -r id title; do
  echo "$id -- $title"
  workspaces[$id]="$title"
done <<< "$(all_ws_id_name)"

# Ref man 7 wofi `window switcher`:
all_win_ws_id_title | {
    while read -r id title; do
      echo "${workspaces[$id]} $title"
    done
  } |
  wofi --show dmenu --insensitive --matching=fuzzy --width=80% --height=70% | {
    # we need to read something after the id to make sure it is not included in
    # the id:
    read -r _output _ _ws_name _ id _
    niri msg action focus-window --id "$id"
  }
